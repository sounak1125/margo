{
  "name": "margo",
  "productName": "Margo",
  "version": "1.0.5",
  "description": "Margo",
  "main": "main.js",
  "author": "Sounak",
  "license": "MIT",
  "repository": "github:sounak1125/margo",
  "scripts": {
    "start": "node scripts/stamp-electron-icon.js && electron .",
    "test": "node scripts/smoke.js",
    "icons": "node scripts/make-icons.js",
    "check:desktop-thumbs": "node scripts/check-desktop-thumbs.js",
    "predist": "node scripts/write-google-oauth.js",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@xmldom/xmldom": "^0.8.15",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.0.2",
    "html-to-docx": "^1.8.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "pptxgenjs": "^4.0.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "uuid": "^11.1.1",
    "builder-util-runtime": "^9.7.0"
  },
  "build": {
    "appId": "com.sounak.margo",
    "productName": "Margo",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**",
      "samples/welcome.md",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/pdf-lib/**",
      "!node_modules/dompurify/**",
      "!node_modules/@napi-rs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Margo ${version}",
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Office",
      "executableName": "margo",
      "synopsis": "Markdown, Word, Excel and PDF documents in one calm editor",
      "description": "Margo reads and edits Markdown, Word, Excel and PDF files in one clean, offline app.",
      "maintainer": "Sounak <sounak1125@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "Margo"
        }
      }
    },
    "publish": {
      "provider": "github",
      "owner": "sounak1125",
      "repo": "margo",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt"
        ],
        "name": "MargoMarkdown",
        "description": "Markdown document",
        "icon": "file-icons/md.ico",
        "mimeType": "text/markdown;text/x-markdown;text/plain",
        "role": "Editor"
      },
      {
        "ext": "docx",
        "name": "MargoWordDocument",
        "description": "Word document",
        "icon": "file-icons/doc.ico",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor"
      },
      {
        "ext": [
          "xlsx",
          "csv"
        ],
        "name": "MargoSpreadsheet",
        "description": "Spreadsheet",
        "icon": "file-icons/sheet.ico",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;text/csv",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "MargoPDF",
        "description": "PDF document",
        "icon": "file-icons/pdf.ico",
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": "pptx",
        "name": "MargoPresentation",
        "description": "PowerPoint presentation",
        "icon": "file-icons/slides.ico",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "role": "Editor"
      }
    ]
  }
}
